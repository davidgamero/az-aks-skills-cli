#!/usr/bin/env python3
"""Development shim: handle aks skill, otherwise exec the installed Azure CLI."""

from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from az_aks_skills_cli.shim import main

if __name__ == "__main__":
    raise SystemExit(main(shim_path=Path(__file__).resolve()))
